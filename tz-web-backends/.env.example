# tz-web-backends secrets — TEMPLATE. Copy sang `.env` trên VM rồi điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env && nano .env

# ── Auth Firecrawl (crawl.timezlab.org) ───────────────────────────────────────────────────
# Bearer mà tz-nginx yêu cầu cho /v1/* của Firecrawl. PHẢI TRÙNG với FIRECRAWL_API_KEY trong
# .env của Hermes (Jarvis + Friday) — Firecrawl SDK gửi `Authorization: Bearer <FIRECRAWL_API_KEY>`.
# Sinh: openssl rand -hex 32
FIRECRAWL_BEARER=

# ── Firecrawl internal ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=        # sinh: openssl rand -hex 16  (đổi khỏi default 'postgres')
BULL_AUTH_KEY=            # sinh: openssl rand -hex 16  (bảo vệ bull dashboard nội bộ)
USE_DB_AUTHENTICATION=false   # self-host: để false (API không tự check key — tz-nginx gác bằng Bearer)

# (tuỳ chọn) LLM cho /v1/extract (trích cấu trúc). Bỏ trống nếu chỉ dùng scrape/markdown:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=

# (tuỳ chọn) cho Firecrawl /v1/search dùng SearXNG của ta — Hermes KHÔNG cần (gọi SearXNG trực tiếp):
# SEARXNG_ENDPOINT=http://tz-searxng:8080

# ── Cloudflare Tunnel (token mode) ─────────────────────────────────────────────────────────
# Token của named tunnel: Zero Trust → Networks → Tunnels → (tunnel) → Install connector → copy token.
# Ingress KHÔNG ở repo — cấu hình Public Hostname trên dashboard (search.*/crawl.* → http://tz-nginx:80).
CLOUDFLARE_TUNNEL_TOKEN=

# Lưu ý:
# - Basic auth của SearXNG (search.*) KHÔNG ở đây — nằm trong file nginx/.htpasswd (sinh bằng htpasswd).
# - secret_key của SearXNG nằm trong searxng/settings.yml (sinh bằng openssl), KHÔNG ở .env.
